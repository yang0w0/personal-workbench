{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "个人工作台",
  "version": "0.1.0",
  "identifier": "com.personalworkbench.desktop",
  "build": { "frontendDist": "../../app" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "个人工作台", "width": 1120, "height": 760, "minWidth": 860, "minHeight": 600, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
